#version 430 core

layout(local_size_x = 256) in;

struct Particle
{
    vec4 position;
    vec4 velocity;
    float age;
    float lifetime;
    vec2 padding;
};

struct SpawnCommand
{
    uint spawn;
    float lifetime;
};

layout(std430, binding = 0) buffer ParticleBuffer
{
    Particle particles[];
};

layout(std430, binding = 1) readonly buffer SpawnBuffer
{
    SpawnCommand spawnCommands[];
};

uniform float deltaTime;
uniform float globalTime;
uniform vec2 emitterPosition;

uniform float attractionStrength;
uniform float vortexStrength;
uniform float turbulenceStrength;
uniform float turbulenceScale;
uniform float damping;

uniform float emitterRadius;
uniform float emitterBaseRadius;
uniform float initialSpeedMin;
uniform float initialSpeedMax;
uniform float randomSizeMin;
uniform float randomSizeMax;

uniform float orbitalBias;
uniform float radialBias;

float hash31(vec3 p)
{
    return fract(sin(dot(p, vec3(127.1, 311.7, 74.7))) * 43758.5453);
}

float particleNoise3D(vec3 p)
{
    vec3 i = floor(p);
    vec3 f = fract(p);

    f = f * f * (3.0 - 2.0 * f);

    float n000 = hash31(i + vec3(0, 0, 0));
    float n100 = hash31(i + vec3(1, 0, 0));
    float n010 = hash31(i + vec3(0, 1, 0));
    float n110 = hash31(i + vec3(1, 1, 0));
    float n001 = hash31(i + vec3(0, 0, 1));
    float n101 = hash31(i + vec3(1, 0, 1));
    float n011 = hash31(i + vec3(0, 1, 1));
    float n111 = hash31(i + vec3(1, 1, 1));

    float z0 = mix(mix(n000, n100, f.x), mix(n010, n110, f.x), f.y);
    float z1 = mix(mix(n001, n101, f.x), mix(n011, n111, f.x), f.y);

    return mix(z0, z1, f.z);
}

vec3 vectorPotential(vec3 p, float t)
{
    p = p * 2.0 + vec3(t * 0.06, -t * 0.04, t * 0.05);

    return vec3(particleNoise3D(p + vec3(17.1, 3.2, 9.2)), particleNoise3D(p + vec3(5.2, 21.7, 13.3)), particleNoise3D(p + vec3(11.8, 7.4, 27.1)));
}

vec3 curlNoise(vec3 p, float t)
{
    const float e = 0.02;

    vec3 dx = (vectorPotential(p + vec3(e, 0, 0), t) - vectorPotential(p - vec3(e, 0, 0), t)) / (2.0 * e);
    vec3 dy = (vectorPotential(p + vec3(0, e, 0), t) - vectorPotential(p - vec3(0, e, 0), t)) / (2.0 * e);
    vec3 dz = (vectorPotential(p + vec3(0, 0, e), t) - vectorPotential(p - vec3(0, 0, e), t)) / (2.0 * e);

    return vec3(dy.z - dz.y, dz.x - dx.z, dx.y - dy.x);
}

float random(float x)
{
    return fract(sin(x * 127.1 + 311.7) * 43758.5453);
}

void respawn(inout Particle p, uint id, float lifetime)
{
    float seed = float(id) * 17.13 + globalTime * 0.71;

    float angle = random(seed) * 6.2831853;
    float z = random(seed + 3.1) * 2.0 - 1.0;
    float circleRadius = sqrt(max(0.0, 1.0 - z * z));

    vec3 radial = vec3(circleRadius * cos(angle), circleRadius * sin(angle), z);

    float radius = emitterBaseRadius + emitterRadius * pow(random(seed + 4.7), 1.0 / 3.0);

    p.position = vec4(vec3(emitterPosition, 0.0) + radial * radius, 1.0);

    vec3 axis = normalize(vec3(0.35, 0.8, 0.25));
    vec3 tangent = cross(axis, radial);

    if (length(tangent) < 0.001)
    {
        tangent = cross(vec3(0.0, 1.0, 0.0), radial);
    }

    tangent = normalize(tangent);

    vec3 direction = normalize(tangent * orbitalBias + radial * radialBias);

    p.velocity = vec4(direction * mix(initialSpeedMin, initialSpeedMax, random(seed + 8.3)), 0.0);
    p.padding.x = mix(randomSizeMin, randomSizeMax, random(seed + 10.7));

    p.age = 0.0;
    p.lifetime = lifetime;
}

void main()
{
    uint id = gl_GlobalInvocationID.x;

    if (id >= uint(particles.length()))
    {
        return;
    }

    Particle p = particles[id];

    if (spawnCommands[id].spawn != 0u)
    {
        respawn(p, id, spawnCommands[id].lifetime);
        particles[id] = p;
        return;
    }

    if (p.age < 0.0)
    {
        return;
    }

    p.age += deltaTime;

    vec3 relative = p.position.xyz - vec3(emitterPosition, 0.0);
    float radius = length(relative);

    if (p.age >= p.lifetime || any(greaterThan(abs(p.position.xyz), vec3(1.15))))
    {
        p.age = -1.0;
        p.position = vec4(2.0, 2.0, 2.0, 1.0);
        p.velocity = vec4(0.0);

        particles[id] = p;
        return;
    }

    vec3 radial = relative / max(radius, 0.001);
    vec3 axis = normalize(vec3(0.35, 0.8, 0.25));
    vec3 tangent = cross(axis, radial);

    if (length(tangent) < 0.001)
    {
        tangent = cross(vec3(0.0, 1.0, 0.0), radial);
    }

    tangent = normalize(tangent);

    vec3 attraction = -radial * attractionStrength;
    vec3 vortex = tangent * (vortexStrength / (0.25 + radius));

    vec3 turbulence = curlNoise(p.position.xyz * turbulenceScale, globalTime);
    turbulence /= max(length(turbulence), 0.001);

    vec3 acceleration = attraction + vortex + turbulence * turbulenceStrength;

    p.velocity.xyz += acceleration * deltaTime;
    p.velocity.xyz *= exp(-damping * deltaTime);
    p.position.xyz += p.velocity.xyz * deltaTime;

    particles[id] = p;
}
